# Salin file ini jadi ".env.local", lalu isi nilai aslinya.
# JANGAN commit file .env.local ke GitHub (sudah otomatis di-skip lewat .gitignore).

# Connection string PostgreSQL dari Neon (sama seperti yang dipakai versi Laravel).
# Ambil di dashboard Neon -> Connection string.
DATABASE_URL="postgresql://neondb_owner:PASSWORD@ep-xxxxx.aws.neon.tech/neondb?sslmode=require"

# Kunci rahasia buat enkripsi sesi login. Generate dengan menjalankan:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET="isi-dengan-string-acak-panjang"

# Alamat website ini sendiri (waktu development lokal, biarkan seperti ini).
NEXTAUTH_URL="http://localhost:3000"

# Kredensial Supabase Storage (S3-compatible) buat upload foto.
S3_ACCESS_KEY_ID="da6134ca703a00d8a9e8e33840572fd8"
S3_SECRET_ACCESS_KEY="isi-secret-access-key-supabase"
S3_REGION="ap-southeast-1"
S3_BUCKET="ruang-tani-foto"
S3_ENDPOINT="https://cqdkuxojtwvuqfshdxwu.storage.supabase.co/storage/v1/s3"
S3_PUBLIC_URL="https://cqdkuxojtwvuqfshdxwu.supabase.co/storage/v1/object/public/ruang-tani-foto"
